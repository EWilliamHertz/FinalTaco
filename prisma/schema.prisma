generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  username          String         @unique
  password          String
  role              Role           @default(USER)
  verified          Boolean        @default(false)
  verificationToken String?
  avatarUrl         String?
  reputationScore   Float          @default(0.0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  CardInstances     CardInstance[]
  MarketListings    MarketListing[]
  Posts             Post[]
  Purchases         Deal[]         @relation("BuyerDeals")
  Sales             Deal[]         @relation("SellerDeals")
  PostLikes         PostLike[]
  Comments          Comment[]
  Followers         Follows[] @relation("Following")
  Following         Follows[] @relation("Followers")
  SentMessages      Message[] @relation("SentMessages")
  ReceivedMessages  Message[] @relation("ReceivedMessages")
  Notifications     Notification[]
}

model CardReference {
  id           String         @id @default(uuid())
  game         GameType
  tcgcsvId     String         @unique // TCGplayer productId from TCGCSV
  groupId      Int? // TCGplayer groupId (set) this product belongs to
  name         String
  cleanName    String?
  setName      String
  setCode      String? // Group abbreviation, e.g. SWSH12, NEO
  number       String? // Collector number, e.g. "139/195" or "7a"
  imageUrl     String?
  rarity       String?
  subTypeName  String? // Normal / Holofoil / Reverse Holofoil
  marketPrice  Float          @default(0.0)
  foilPrice    Float?
  reversePrice Float?
  lowPrice     Float?
  highPrice    Float?

  Group        CardGroup?     @relation(fields: [groupId], references: [groupId])
  Instances    CardInstance[]
}

model CardGroup {
  groupId      Int            @id // TCGplayer groupId
  categoryId   Int // 1 = MTG, 3 = Pokemon on TCGplayer
  name         String
  abbreviation String?
  publishedOn  DateTime?
  syncedAt     DateTime?

  Cards        CardReference[]

  @@index([categoryId, abbreviation])
}

model CardInstance {
  id           String         @id @default(uuid())
  ownerId      String
  cardId       String
  condition    Condition      @default(NEAR_MINT)
  purchasePrice Float?
  customPrice   Float?
  notes        String?
  acquiredAt   DateTime       @default(now())

  Owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Card         CardReference  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  Listings     MarketListing[]

  @@index([ownerId])
}

model MarketListing {
  id             String         @id @default(uuid())
  sellerId       String
  cardInstanceId String
  price          Float
  status         ListingStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())

  Seller         User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  CardInstance   CardInstance   @relation(fields: [cardInstanceId], references: [id], onDelete: Cascade)
  Deal           Deal?
}

model Deal {
  id              String         @id @default(uuid())
  buyerId         String
  sellerId        String
  marketListingId String         @unique
  price           Float
  status          DealStatus     @default(PENDING_PAYMENT)
  createdAt       DateTime       @default(now())

  Buyer           User           @relation("BuyerDeals", fields: [buyerId], references: [id])
  Seller          User           @relation("SellerDeals", fields: [sellerId], references: [id])
  Listing         MarketListing  @relation(fields: [marketListingId], references: [id])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  images    String[]
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  Author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  PostLikes PostLike[]
  Comments  Comment[]
}

enum Role {
  USER
  ADMIN
}

enum GameType {
  POKEMON
  MTG
}

enum Condition {
  MINT
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum DealStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  Author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}


model Follows {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  Follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  Following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  Sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  Receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  
  @@index([senderId, receiverId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String   // e.g. "LIKE", "COMMENT", "FOLLOW", "TRADE"
  content    String
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  User       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
